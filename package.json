{
  "name": "hospital-management-system",
  "version": "1.0.0",
  "description": "A comprehensive full-stack hospital management system",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest --coverage",
    "lint": "eslint backend/**/*.js",
    "migrate": "node database/migrate.js",
    "seed": "node database/seed.js",
    "docker:build": "docker build -t hospital-system:latest .",
    "docker:run": "docker run -p 5000:5000 hospital-system:latest"
  },
  "keywords": [
    "hospital",
    "management",
    "system",
    "healthcare",
    "patient",
    "appointment",
    "doctor"
  ],
  "author": "Mohamed Masood",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.8.0",
    "jsonwebtoken": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5",
    "axios": "^1.3.4",
    "redis": "^4.6.5",
    "nodemailer": "^6.9.1",
    "validator": "^13.9.0",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.7.0",
    "compression": "^1.7.4",
    "express-validator": "^7.0.0",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "eslint": "^8.38.0",
    "@faker-js/faker": "^7.6.0"
  }
